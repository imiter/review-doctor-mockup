# 로컬 개발용 예시. 실제 값을 채운 .env는 커밋하지 않는다.

# PostgreSQL 접속 문자열. 미설정 시 아래 기본값(로컬 docker compose db)을 사용한다.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/delivery_insight

# JWT 서명 키. 미설정 시 개발용 기본값을 쓰지만 운영 배포에서는 반드시 32바이트 이상으로 채운다.
JWT_SECRET=dev-secret-change-in-production-min-32-bytes

# 배포된 프론트엔드 도메인 (예: https://xxx.up.railway.app). 로컬 개발은 CORS가
# localhost:포트 정규식으로 자동 허용되므로 비워둬도 된다.
FRONTEND_ORIGIN=

# 카카오 로그인. 카카오 디벨로퍼스 콘솔에서 발급. 이 프로젝트의 카카오 앱은
# Client Secret이 필수다 (없으면 invalid_client/KOE010).
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 반경별 실측 광고 순위 크롤링을 위임할 워커 URL/시크릿. 배포 환경에서만 설정
# (로컬 개발은 crawler/ venv가 있으면 직접 실행하므로 비워둬도 된다).
CRAWL_WORKER_URL=
CRAWL_WORKER_SECRET=
