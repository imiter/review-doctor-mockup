# 로컬 개발용 예시. 실제 값을 채운 .env.local은 커밋하지 않는다.

# 백엔드 API 주소. 미설정 시 http://localhost:8000을 사용한다.
NEXT_PUBLIC_API_URL=http://localhost:8000

# 카카오 로그인 앱 키(REST API 키가 아니라 JavaScript 키). 카카오 디벨로퍼스
# 콘솔에서 발급. 빌드 시점에 없으면 카카오 로그인 버튼 클릭 시 에러가 표시된다.
NEXT_PUBLIC_KAKAO_CLIENT_ID=

# 광고 순위 모니터링 화면에서 "우리가게 순위 확인"(실기기 크롤링) 버튼을
# 노출할지 여부. "true"가 아니면 버튼이 숨겨진다.
NEXT_PUBLIC_LIVE_CRAWL_ENABLED=false

# 토스페이먼츠 결제위젯 클라이언트키(테스트 키만 사용, test_ck_로 시작). 브라우저에
# 노출되는 값이라 NEXT_PUBLIC_ 접두어 필수. developers.tosspayments.com에서 발급.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
